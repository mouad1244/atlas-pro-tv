{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "atlas-pro-tv",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "iron-tv-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "../atlas-iron-tv-worktree", "run", "dev", "--", "-p", "3010"],
