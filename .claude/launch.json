    },
    {
      "name": "numora-admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "numora/admin", "run", "dev"],
      "port": 3002
    },
    {
      "name": "numora-backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "numora/backend", "run", "dev"],
      "port": 4000
    }
  ]
}
